# Kopier denne filen til ".env" lokalt (og legg de samme verdiene inn i
# Vercel sitt dashbord under Settings > Environment Variables i produksjon).
# ALDRI last opp den ekte ".env"-filen eller de ekte nøklene til GitHub.

# Finnes i Stripe-dashbordet under Developers > API keys.
# Bruk sk_test_... mens du tester, bytt til sk_live_... når dere går live.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Finnes i Stripe-dashbordet under Developers > Webhooks, etter du har
# opprettet webhook-endepunktet (se README for stegene).
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Den ekte URL-en til nettsiden deres når den er live, f.eks.
# https://leaveareview.no  (uten skråstrek på slutten)
SITE_URL=https://leaveareview.no

# Finnes på resend.com/api-keys, etter du har opprettet konto (se README).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# E-postadressen DERE vil motta meldinger fra "Snakk med oss"-skjemaet på.
CONTACT_EMAIL=post@dinbedrift.no
